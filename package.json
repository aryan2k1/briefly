{
  "name": "briefly-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4319",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:local": "node scripts/local-postgres.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "lint": "eslint src scripts tests next.config.ts",
    "format:check": "prettier --check src scripts tests next.config.ts eslint.config.mjs package.json tsconfig.json",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
